# Names only, never values. Copy to .env (gitignored) or export them in your shell.
# None is needed to build, test or run zsv-ruby.

# bin/* switches (read in bin/_dx.sh and bin/check; CI sets both).
# 1 = use whatever Ruby is active instead of the one in .ruby-version.
ZSV_ANY_RUBY=
# 1 = a missing clang-format is exit 75 instead of NOT GRADED.
ZSV_REQUIRE_CLANG_FORMAT=

# MCP servers in .mcp.json. A server whose variables are unset fails to connect; the rest keep working.
# sentry-mcp
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=
# developerz (https://mcp.developerz.ai)
DEVELOPERZ_API_KEY=
